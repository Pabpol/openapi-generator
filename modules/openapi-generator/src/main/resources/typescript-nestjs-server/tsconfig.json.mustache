{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2015",
        "lib": [
            "es2015",
            "dom"
        ],
        "types": ["node"],
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "./*"
    ],
    "filesGlob": [
        "./model/*.ts",
        "./api/*.ts"
    ]
}