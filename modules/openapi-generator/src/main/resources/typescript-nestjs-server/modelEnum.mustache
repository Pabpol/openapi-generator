{{#stringEnums}}
    export enum {{classname}} {
    {{#allowableValues}}
        {{#enumVars}}
            {{name}} = {{{value}}}{{^-last}},{{/-last}}
        {{/enumVars}}
    {{/allowableValues}}
    }
{{/stringEnums}}
{{^stringEnums}}
    export type {{classname}}Key = {{#allowableValues}}{{#enumVars}}'{{{value}}}'{{^-last}} | {{/-last}}{{/enumVars}}{{/allowableValues}};

    export class {{classname}} {
        static readonly mapping ={
        {{#allowableValues}}{{#enumVars}}
            {{{name}}}: '{{{value}}}'{{^-last}},{{/-last}}
        {{/enumVars}}{{/allowableValues}}
        } as const;

      static fromString(value: string): {{classname}}Key | undefined {
        const entries = Object.entries(this.mapping) as [{{classname}}Key, string][];
        const found = entries.find(([_, val]) => val === value);
        return found ? found[0] : undefined;
    }
    };
{{/stringEnums}}