import { Module, Type, DynamicModule, Provider } from '@nestjs/common';
import { Reflector } from '@nestjs/core';
{{#requiresScopeGuardGlobal}}import { ScopeGuard } from './src/guards/scope.guard';
{{/requiresScopeGuardGlobal}}
{{#controllers}}import { {{controllerName}}{{controllerSuffix}} } from './src/controllers/{{controllerFileName}}';
{{/controllers}}


@Module({
    controllers: [
    {{#controllers}}
        {{controllerName}}{{controllerSuffix}},
    {{/controllers}}
    ]
})
export class ApiModule {
  static forRoot(options: {
    providers: Array<{
      token: string;
      implementation: Type<any>;
    }>;
    imports?: any[];
  }): DynamicModule {
    const moduleProviders: Provider[] = [
      Reflector,
      {
        provide: ScopeGuard,
        useFactory: (reflector: Reflector) => new ScopeGuard(reflector),
        inject: [Reflector],
      },
    ];

    const moduleExports: any[] = [
      Reflector,
      ScopeGuard,
    ];

    // Agregar cada provider dinámicamente
    options.providers.forEach(provider => {
      moduleProviders.push({
        provide: provider.token,
        useExisting: provider.implementation
      });
      moduleExports.push(provider.token);
    });

    return {
      module: ApiModule,
      imports: options.imports || [],
      providers: moduleProviders,
      exports: moduleExports,
    };
  }
}