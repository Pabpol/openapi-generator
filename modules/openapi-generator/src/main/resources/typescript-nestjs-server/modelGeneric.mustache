{{#useValidations}}
    import { IsOptional, IsNotEmpty, IsString, IsNumber, IsUUID, IsBase64, MinLength, MaxLength, Matches, Min, Max } from 'class-validator';
{{/useValidations}}
export class {{classname}}{{#allParents}}{{#-first}} extends {{/-first}}{{{.}}}{{^-last}}, {{/-last}}{{/allParents}} {
{{>modelGenericAdditionalProperties}}
{{#vars}}
    {{#useValidations}}
        {{#isRequired}}
            @IsNotEmpty()
        {{/isRequired}}
        {{#isString}}
            @IsString()
            {{#minLength}}
                @MinLength({{minLength}})
            {{/minLength}}
            {{#maxLength}}
                @MaxLength({{maxLength}})
            {{/maxLength}}
            {{#pattern}}
                @Matches(/{{pattern}}/)
            {{/pattern}}
        {{/isString}}
        {{#isNumber}}
            @IsNumber()
            {{#minimum}}
                @Min({{minimum}})
            {{/minimum}}
            {{#maximum}}
                @Max({{maximum}})
            {{/maximum}}
        {{/isNumber}}
        {{#isUUID}}
            @IsUUID()
        {{/isUUID}}
        {{#isBase64}}
            @IsBase64()
        {{/isBase64}}
        {{#isOptional}}
            @IsOptional()
        {{/isOptional}}
    {{/useValidations}}
    public {{#hasSanitizedName}}{{{name}}}{{/hasSanitizedName}}{{^hasSanitizedName}}{{{name}}}{{/hasSanitizedName}}{{^required}}?{{/required}}: {{#isEnum}}{{{datatypeWithEnum}}}{{/isEnum}}{{^isEnum}}{{{dataType}}}{{/isEnum}}{{#isNullable}} | null{{/isNullable}};
{{/vars}}
}
{{>modelGenericEnums}}
