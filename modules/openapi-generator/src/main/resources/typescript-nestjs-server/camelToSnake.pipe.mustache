import { Injectable, NestInterceptor, ExecutionContext, CallHandler } from '@nestjs/common';
import { map } from 'rxjs/operators';
import { Observable } from 'rxjs';
import { isPlainObject, snakeCase } from 'lodash';
import { instanceToPlain } from 'class-transformer';

@Injectable()
export class CamelToSnakePipe implements NestInterceptor {
    intercept(context: ExecutionContext, next: CallHandler): Observable<any> {
        return next.handle().pipe(
            map(data => this.convertKeysToSnakeCase(data))
        );
    }

    private convertKeysToSnakeCase(obj: any): any {
        if (Array.isArray(obj)) {
            return obj.map(value => this.convertKeysToSnakeCase(value));
        } else if (this.isObject(obj)) {
            // Convert non-plain objects (i.e. class instances) to plain objects
            const plainObj = isPlainObject(obj) ? obj : instanceToPlain(obj);
            const newObj = {};
            Object.keys(plainObj).forEach(key => {
                const newKey = snakeCase(key);
                newObj[newKey] = this.convertKeysToSnakeCase(plainObj[key]);
            });
            return newObj;
        }
        return obj;
    }

    private isObject(value: any): boolean {
        return value !== null && (typeof value === 'object' || typeof value === 'function');
    }
}